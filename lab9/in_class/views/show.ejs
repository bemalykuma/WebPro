<!-- home.ejs -->
<!doctype html>
<html lang="en">
    <%- include("head") %>

<body>
    <!-- heaher -->
    <%- include("header") %>

    <!-- Content -->
    <table border="1">
        <thead>
            <tr>
                <th>Employee ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Title</th>
                <th>Phone</th>
                <th>Email</th>
            </tr>
        </thead>
        <% data.forEach((item)=>{ %>
            <tr>
                <td><%=item.EmployeeId%></td>
                <td><%=item.FirstName%></td>
                <td><%=item.LastName%></td>
                <td><%=item.Title%></td>
                <td><%=item.Phone%></td>
                <td><%=item.Email%></td>
                <td><a href="/delete/<%=item.EmployeeId%>" class="delete-link">Delete</a></td>
            </tr>
            <% }); %>   
        </table>

    <!-- footer -->
    <%- include("footer") %>
    
</body>

</html>