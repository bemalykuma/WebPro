<!DOCTYPE html>
<html lang="en">
 <%- include("head") %>
 <style>
        body {
            justify-content: center;
            display: flex;
            align-items: center;
            min-height: 100vh;
        }
        h1 {
            font-weight: bold;
            color: rgb(255, 0, 179);
        }
        p {
            font-size: 18px;
        }
        .card {
            width: 600px;
            box-shadow: 0 0 20px  rgba(120, 120, 120, 0.381);
            padding: 16px;
            border-radius: 10px;
            background-color: white;
            margin: auto;
        }
             .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        .dark .glass-card {
            background: rgba(15, 23, 42, 0.7);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255, 255, 255, 0.1);
        }
        .mesh-gradient {
            background-color: #f8fafc;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(255, 107, 107, 0.15) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(32, 201, 151, 0.15) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(77, 171, 247, 0.15) 0px, transparent 50%);
        }
        .dark .mesh-gradient {
            background-color: #0f172a;
            background-image: 
                radial-gradient(at 0% 0%, rgba(99, 102, 241, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 0%, rgba(255, 107, 107, 0.1) 0px, transparent 50%),
                radial-gradient(at 100% 100%, rgba(32, 201, 151, 0.1) 0px, transparent 50%),
                radial-gradient(at 0% 100%, rgba(77, 171, 247, 0.1) 0px, transparent 50%);
        }
 </style>
<body>
    <div class="card">
        <h1>User Details</h1>
        <p>ID: <%= data.id %></p>
        <p>First Name: <%= data.first_name %></p>
        <p>Last Name: <%= data.last_name %></p>
        <p>Username: <%= data.username %></p>
        <p>Email: <%= data.email %></p>
        <a href="/">Back to Users List</a>
    </div>
</body>
</html>