<!DOCTYPE html>
<html lang="en">
<%- include("head") %>
<style>
        body {
            background-color: rgb(255, 255, 255);
            margin: 20px;
            justify-self: center;
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            flex-direction: column;
        }
        h1 {
            font-weight: bold;
        }
        th, td {
            padding: 3px 70px 3px 10px;
            
        }
        th {
            color: aliceblue;
            background-color: rgb(255, 37, 168);
        }
        button {
            border-radius: 5px;

        }
        .btn-primary {
            background-color: rgb(181, 32, 255);
            color: white;
            border: none;
            padding: 5px 10px;
        }
        
        tr:nth-child(even) {
            background-color: rgba(240, 240, 240, 0.59);
        }
        h1 {
            color: rgb(255, 255, 255);
            text-shadow: 2px 2px 0px rgba(168, 56, 153, 0.418) ;
        }
    </style>
<body>
    <h1>Users List</h1>
    <table class=" table-striped table-bordered">
        <thead>
            <tr>
                <th>ID</th>
                <th>First Name</th>
                <th>Last Name</th>
                <th>Username</th>
                <th>Email</th>
                <th>Action</th>
            </tr>
        </thead>
        <tbody>
            <% data.forEach(row => { %>
                <tr>
                    <td><%= row.id %></td>
                    <td><%= row.first_name %></td>
                    <td><%= row.last_name %></td>
                    <td><%= row.username %></td>
                    <td><%= row.email %></td>                    
                    <td><a href="/detail/<%= row.id %>"><button class="btn-primary">Details</button></a></td>
                </tr>                
            <% }); %>
        </tbody>        
    </table>    
</body>
</html>