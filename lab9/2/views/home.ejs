<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css">
    <title>Questions</title>

    <style>
        * {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        }
        .question {
            border: 1px solid #ffb7ec;
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            margin: 20px;
            background-color: white;
            width: 97%;
            padding: 30px;
            height: 100%;
        }
        body {

            width: 100%;
            height: 100%;
            background: url(/images/bg.png), url(/images/bg_gradation_01.png) repeat-x top left, #f5f5f5;
        }

        .card {
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }
        h1 {
            text-align: center;
            margin-top: 20px;
            font-weight: bolder;
            color: rgb(255, 255, 255);
            text-shadow: 3px 3px 0px rgb(248, 177, 224);
            margin-bottom: 30px;
        }
        input[type="radio"] {
            margin-right: 5px;
            accent-color: rgb(255, 0, 166);
            
        }
        p {
            font-size: 18px;
            font-weight: bold;
            color: rgb(255, 0, 166);
        }
        .inner {
            background: -webkit-gradient(linear, left top, right top, from(rgb(255, 180, 210)), to(rgb(210, 180, 255)));
            background: -webkit-linear-gradient(left, rgb(255, 180, 210) 0%, rgb(210, 180, 255) 100%);
            background: linear-gradient(90deg, rgb(255, 180, 210) 0%, rgb(210, 180, 255) 100%);
            border-radius: 10px;
            padding: 5px;
            margin-top: -20px;
            
        }
        .layout {
            padding: 15px;
            margin-bottom: 10px;
            border-radius: 5px;
            margin: 20px;
            width: 95%;
            
        }
        
    </style>
</head>
<body>
    <h1>Questions</h1>
    <% data.forEach((item)=>{ %>
    <div class="layout">
        <div class="inner">
            <div class="question">
                <p><%= item.QID %>. <%= item.Stem %></p>
                <label>
                    <input type="radio" name="q_<%= item.QID %>" value="A">
                    <%= item.Alt_A %>
                </label><br>
                <label>
                    <input type="radio" name="q_<%= item.QID %>" value="B">
                    <%= item.Alt_B %>
                </label><br>
                <label>
                    <input type="radio" name="q_<%= item.QID %>" value="C">
                    <%= item.Alt_C %>
                </label><br>
                <label>
                    <input type="radio" name="q_<%= item.QID %>" value="D">
                    <%= item.Alt_D %>
                </label><br>
            </div>
        </div>
    </div>
    <% }); %>
</body>
</html>