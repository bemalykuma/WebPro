<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>My Products</title>
        <style>
            * {
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            }
             .card {
                border: 10px double #d0ac27;
                padding: 16px;
                margin: 10px auto;
                width: 50%;
                height: auto;
                background-color: #ffffff;
                box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1);
            }
                h1 {
                    text-align: center;
                    color: #d6a834;
                }
                body {
                    background-color: #ffffff;
                    background: url('images/bg.png');
                }
                h2 {
                    color: #d6a834;
                }
                .desc {
                    color: #575757;
                }
                .pr {
                    border: 2px double #d6a834;
                    padding: 10px;
                    color: #ffffff;
                    font-weight: bold;
                    border-radius: 10px;
                    background-color: #aa7f137c;
                }
                .am {
                    border: 2px double #d6a834;
                    padding: 10px;
                    color: #ffffff;
                    font-weight: bold;
                    border-radius: 10px;
                    background-color: #aa7f137c;
                }
                
        </style>
    </head>
    <body>
        <h1>Book Shelf</h1>
        <% data.forEach((item)=>{ %>
            <div class="card">
                <h2>Book #<%=item.id%> <%=item.name%></h2>
                <p class="desc"><%=item.description%></p>
                <p class="pr">Price: <%=item.price%></p>
                <p class="am">Amount: <%=item.amount%></p>
            </div>
        <% }); %>
    </body>
</html>

