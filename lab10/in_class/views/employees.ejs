<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Employees List</title>
    <style>
        .card {
            border: 1px solid #ccc;
            padding: 10px;
            margin: 10px;
            text-align: center;
            float: left;
            width: 150px;


        }
        .card img {
            width: 100%;
            height: 150px;
            object-fit: cover;
        }
        button {
            margin-top: 10px;
            padding: 5px 10px;
            background-color: #007BFF;
            color: white;
            border: none;
            cursor: pointer;
        }
    </style>
</head>
<body>
    <h1>Panda Company</h1>
    <% data.forEach((item)=>{ %>
        <div class="card">
            <img src="http://webdev.it.kmitl.ac.th:4000/emp-images/<%=item.EmployeeID%>.png" alt="">
            <p><%=item.FirstName%> <%=item.LastName%></p>
            <a href="/employees/<%=item.EmployeeID%>"><button>Detail</button></a>
        </div>
    <% }); %>   
</body>
</html>