<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Detail</title>
    <style>
        body {
            background-color: #000000;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
        }
        button {
            background-color: #ffffff;
            padding: 10px 20px;
            border: 2px solid #d6a834;
            cursor: pointer;
            width: 100px;
            margin-top: 10px;
            color: #d6a834;
            font-weight: bold;
            font-size: 16px;
        }
        button:hover {
            background-color: #d6a834;
            color: #ffffff;
        }
        span {
            display: flex;
            align-items: center;
            gap: 20px;
        }
        h1 {
            color: #d6a834;
        }
        .card {
            border: 10px double #d0ac27;
            padding: 16px;
            margin: 10px auto;
            width: 50%;
            height: auto;
            background-color: #ffffff;
        }
        .card img {
            width: 100%;
            height: 300px;
            object-fit: cover;
        }
        h2 {
            color: #d6a834;
        }
        .desc {
            color: #575757;
        }

        .price, .am {
            border: 2px double #d6a834;
            padding: 10px;
            color: #ffffff;
            font-weight: bold;
            border-radius: 10px;
            background-color: #aa7f137c;
        }
    </style>
</head>
<body>
    <div>
        <div class="card">

            <span><a href="/"><button>< Back</button></a><h1>#<%=data.product_id%> Product Detail</h1></span>
                
                <img src="<%=data.image_url%>" alt="">
                <h2><%=data.name%></h2>
                <p class="desc"><%=data.description%></p>
                <span>
                    <p class="price">Price : <%=data.price%> THB</p>
                    <p class="am">Amount : <%=data.quantity%></p>
                </span>
                
        
        </div>
    </div>
</body>
</html>

