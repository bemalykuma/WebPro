<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>My Products</title>
        <style>
            * {
                font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;
            }
            h1 {
                text-align: center;
                color: #d6a834;
            }
            body {
                background-color: #000000;
            }
            .card {
                border: 10px double #d0ac27;
                padding: 16px;
                margin: 10px;
                float: left;
                width: 20%;
                height: 350px;
                background-color: #ffffff;
            }
            .card img {
                width: 100%;
                height: 200px;
                object-fit: cover;
            }
            button {
                background-color: #ffffff;
                padding: 10px 20px;
                border: 2px solid #d6a834;
                cursor: pointer;
                width: 100%;
                margin-top: 10px;
                color: #d6a834;
                font-weight: bold;
            }
            button:hover {
                background-color: #d6a834;
                color: #ffffff;
            }
            a {
                text-decoration: none;
            }
            p {
                color: #575757;
            }
        </style>
    </head>
    <body>
        <h1>My Products</h1>
        <% data.forEach((item)=>{ %>
            <div class="card">
                <img src="<%=item.image_url%>" alt="">
                <h3><%=item.name%></h3>
                <p><%=item.description%></p>
                <a href="detail/<%=item.product_id%>"><button>Detail</button></a>
            </div>
        <% }); %>
    </body>
</html>

