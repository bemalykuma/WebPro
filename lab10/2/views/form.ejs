<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Task</title>
    <style>
        * {
            font-family: 'Trebuchet MS', 'Lucida Sans Unicode', 'Lucida Grande', 'Lucida Sans', Arial, sans-serif;
        }
        body {
            background: url('/images/bg.png'), #ffffff;
            padding: 20px;
        }
        h1 {
            color: #5c4254;
        }
        .card {
            background-color: #ffdfec87;
            border: 1px solid #ccc;
            padding: 20px;
            width: 400px;
            margin: 0 auto;
            border-radius: 10px;

        }
        label {
            font-weight: bold;
        }
        input[type="text"], textarea, input[type="date"] {
            width: 90%;
            padding: 10px;
            margin-top: 5px;
            margin-bottom: 15px;
            border: 1px solid #ccc;
            border-radius: 5px;
        }
        input[type="submit"] {
            background-color: #ff00aa;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        input[type="submit"]:hover {
            background-color: #b50079;
        }

        textarea {
            height: 100px;
        }
        a {
            display: inline-block;
            margin-bottom: 20px;
            color: #ff00aa;
            text-decoration: none;
            background-color: #ffdfec87;
            padding: 10px 20px;
            border-radius: 5px;
        }
        a:hover {
            background-color: #ff00aa;
            color: white;
        }
    </style>
</head>
<body>
    <a href="/">Back to Tasks</a>
    <div class="card">

        <h1>Create New Task</h1>
        <form action="/api/tasks" method="POST">
            <label for="title">Title:</label><br>
            <input type="text" id="title" name="title" placeholder="Enter task title"><br><br>
            <label for="description">Description:</label><br>
            <textarea id="description" name="description" placeholder="Enter task description"></textarea><br><br>
            <label for="deadline">Deadline:</label><br>
            <input type="date" id="deadline" name="deadline"><br><br>
            <input type="submit" value="Create Task">
        </form>
    </div>

</body>
</html>
