<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Products</title>
    <style>
        body {
            font-family: Arial, sans-serif;
                background-color: #f4f4f4;
                padding: 20px;
        }
        .card {
            background-color: white;
            border: 1px solid #ccc;
            padding: 10px;
            margin: 10px;
            width: 300px;
            display: inline-block;
            vertical-align: top;
            border-radius: 5px;
            height: 450px;
        }
        .card img {
            max-width: 100%;
            height: 300px;
            object-fit: cover;
        }
        .card h3 {
            margin: 0;
            font-size: 1.2em;
        }
        button {
            background-color: #4c6daf;
            color: white;
            padding: 10px 20px;
            border: none;
            cursor: pointer;
            margin-top: 15px;
            border-radius: 5px;
            width: 100%;
        }
         button:hover {
            background-color: #454ca0;
        }
        nav {
            margin-bottom: 20px;
            background-color: rgb(57, 57, 57);
            padding: 20px;
            color: white;
            text-decoration: none;
        }
        nav a {
            color: white;
            text-decoration: none;
            margin-right: 10px;
            height: 100%;
             display: inline-block;
             padding: 10px 20px;
            
        }
        nav a:hover {
            background: #000;

        }
    </style>
</head>
<h1>Phone Products</h1>
<nav>
    <a href="/products">Products</a>
    <a href="/cart">Cart</a>
</nav>
<!-- views/showproducts.ejs -->
<!-- 
รูปภาพอยู่ใน http://webdev.it.kmitl.ac.th/phone-images/ 
-->
    <body>
        <% data.forEach((item)=>{ %>
        <div class="card">
                 <img src="http://webdev.it.kmitl.ac.th/phone-images/<%= item.pimage %>" alt="<%= item.name %>" width="100%">
                <br>
                <h3><%=item.id%>. <%=item.name%></h3>
                
                <br>
                    Storage: <%= item.storage%>
                <br>
                    Camera: <%= item.camera%>
                <br>
                     Price: <%= item.price%> baht
                <br>
                <a href="/add-to-cart/<%= item.id %>"><button>Add to Cart</button></a>
            </div>
            <% }); %>   
    </body>
</html>