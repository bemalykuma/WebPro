<!DOCTYPE html>
<html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>The most popular albums</title>
        <style>
        body {
            font-family: system-ui, -apple-system, Segoe UI, Roboto, Ubuntu, Cantarell, "Helvetica Neue", Arial, "Noto Sans", "Apple Color Emoji", "Segoe UI Emoji", "Segoe UI Symbol", "Noto Color Emoji", sans-serif;
            margin: 20px;
            background-color: rgb(0, 0, 0);
            width: 100%;
            height: 100%;
            background: url(/images/bg.png), url(/images/bg_gradation_01.png) repeat-x top left, #f5f5f5;
            
        }
        .card {
            background-color: #ffffff;
            border-radius: 5px;
            max-width: 93.5%;
            box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
            padding: 15px;
        }
        img {
            width: 100%;
            border-top-left-radius: 5px;
            border-top-right-radius: 5px;
            height: 300px;
            object-fit: cover;
            
        }
        .inner {
            height: 100%;
            background: -webkit-gradient(linear, left top, right top, from(rgb(255, 180, 210)), to(rgb(210, 180, 255)));
            background: -webkit-linear-gradient(left, rgb(255, 180, 210) 0%, rgb(210, 180, 255) 100%);
            background: linear-gradient(90deg, rgb(255, 180, 210) 0%, rgb(210, 180, 255) 100%);
            border-radius: 10px;
            padding: 5px;
            margin-top: -20px;
            
        }
        .layout {
            float: left;
            width: 30%;
            margin-top: 20px;
            margin-left: 10px;
            margin-bottom: 20px;
        }
        h2 {
            color: #ff006e;
            margin: 5px 0 5px 0;
            font-weight: bolder;
        }
        h1 {
            color: white;
            margin-bottom: 20px;
            text-align: center;
            text-shadow: 2px 2px 0px #8d82ac67;
            
        }
        p {
            margin: 15px 0;
            color: #330029;
            font-weight: 600;
        }
        span {
            font-weight: normal;
            color: #656565;
        }
        @media screen and (max-width: 900px) {
            .layout {
                width: 45%;
            }
        }
        @media screen and (max-width: 700px) {
            .layout {
                width: 95%;
            }
        }
    </style>
    </head>
    <body>
        <div>
            <h1>The most popular albums</h1>
            <% data.forEach(function(data) { %>
            <div class="layout">
                <div class="inner">
                    <div class="card">
                        <img
                            src="<%= data.album_cover %>"
                            alt>
                            <h2><%= data.song %></h2>
                            <p>Album: <span><%= data.album %></span></p>
                            <p>Artist: <span><%= data.artist %></span></p>
                            <p>Genre: <span><%= data.genre %></span></p>
                    </div>
                </div>
            </div>
            <% }); %>
        </body>
    </html>