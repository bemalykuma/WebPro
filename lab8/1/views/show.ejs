<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Users Data</title>
    <style>
        body {
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, 'Open Sans', 'Helvetica Neue', sans-serif;            margin: 20px;
            background-color: rgb(217, 217, 217);
            background: url(/images/bg.png), url(/images/bg_gradation_01.png) repeat-x top left,url(/images/bg_gradation_02.png) repeat-x top left, #f5f5f5;

        }
        table {
            width: 100%;
            border-collapse: collapse;
        }
        th, td {
            padding: 8px 12px;
            border: 1px solid #eeeeee;
            text-align: left;

        }
        th {
            background-color: rgb(255, 180, 243);
            color: white;

        }
        tr:nth-child(even) {
            background-color: rgba(249, 249, 249, 0.5);
        }
        tr:nth-child(odd) {
            background-color: #ffffff;
        }

        h1 {
            color: #ffffff;
            text-shadow: 2px 2px 0px #e0008673;
            text-align: center;
        }
        
    </style>
</head>
<body>
    <h1>Users Table</h1>

    <table border="1">
        <tr>
            <th>Username</th>
            <th>Password</th>
            <th>Email</th>
            <th>First Name</th>
            <th>Last Name</th>
            <th>Age</th>
            <th>Address</th>
            <th>Phone</th>
        </tr>
        <% data.forEach((item) => { %>
        <tr>
            <td><%= item.username %></td>
            <td><%= item.password %></td>
            <td><%= item.email %></td>
            <td><%= item.firstname %></td>
            <td><%= item.lastname %></td>
            <td><%= item.age %></td>
            <td><%= item.address %></td>
            <td><%= item.phone %></td>
        </tr>
        <% }); %>
    </table>

</body>
</html>